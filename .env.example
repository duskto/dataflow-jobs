# Defaults: local SQLite + a separate polling worker, single demo account.
DF_DATABASE_URL=sqlite:///./data/dataflow.db
DF_STORAGE_ROOT=./data/storage
DF_EXECUTION_MODE=local
DF_REDIS_URL=redis://localhost:6379/0
DF_LEASE_SECONDS=30
DF_RETRY_BASE_SECONDS=2
DF_MAX_UPLOAD_BYTES=104857600
DF_MAX_ROWS=1000000
DF_MAX_UNIQUE_KEYS=200000
DF_MAX_GROUPS=100000
# Optional shared demo token. Set before exposing beyond localhost.
DF_API_TOKEN=

# Archival is lossless; active inputs are excluded and old inputs remain reusable.
DF_INPUT_ARCHIVE_DAYS=30
DF_EVENT_ARCHIVE_DAYS=30
DF_MAINTENANCE_INTERVAL_SECONDS=3600
DF_MAINTENANCE_BATCH_SIZE=100
DF_HEARTBEAT_INTERVAL_SECONDS=5
DF_HEARTBEAT_TIMEOUT_SECONDS=20
DF_ALERT_QUEUE_AGE_SECONDS=120
DF_ALERT_FAILURE_RATE=0.2
DF_ALERT_FAILURE_MIN_JOBS=5
# Optional Compose overrides: DF_API_PORT, DF_WORKER_CONCURRENCY,
# DF_PROMETHEUS_PORT, DF_ALERTMANAGER_PORT.
